{
  "kind": "collectionType",
  "collectionName": "nav_items",
  "info": {
    "singularName": "nav-item",
    "pluralName": "nav-items",
    "displayName": "Nav Item",
    "description": "Site navigation menu items (header desktop + mobile)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "link": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "autoSubmenu": {
      "type": "enumeration",
      "enum": ["none", "categories"],
      "default": "none"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::nav-item.nav-item",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::nav-item.nav-item",
      "mappedBy": "parent"
    }
  }
}
